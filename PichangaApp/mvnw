#!/usr/bin/env bash
set -e

MAVEN_WRAPPER_VERSION="3.1.0"
MAVEN_VERSION="3.10.0"
MAVEN_WRAPPER_JAR="maven-wrapper-${MAVEN_WRAPPER_VERSION}.jar"
MAVEN_WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/${MAVEN_WRAPPER_VERSION}/${MAVEN_WRAPPER_JAR}"

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}-bin"

if [ ! -d "${MAVEN_HOME}" ]; then
    mkdir -p "${MAVEN_HOME}"
fi

if [ ! -f "${MAVEN_HOME}/bin/mvn" ]; then
    echo "Descargando Maven ${MAVEN_VERSION}..."
    curl -sSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" | tar -xz -C "${MAVEN_HOME}" --strip-components=1
fi

"${MAVEN_HOME}/bin/mvn" "$@"
